              "name": "F37 camera & lens",
              "description": "The camera module and lens capture images for vision applications. The short flexible cable connects it to the board’s camera connector."
            },
            {
              "key": "camera-ribbon",
              "name": "Camera ribbon & connector",
              "description": "The flexible cable carries the camera connection to the FPC socket. Disconnect power before handling the cable or its latch."
            },
            {
              "key": "usb-soc",
              "name": "RTL8735B USB",
              "description": "The Micro USB connector marked 8735 connects to the SoC USB interface. Its behavior depends on the loaded firmware."
            },
            {
              "key": "usb-uart",
              "name": "USB UART (CH340)",
              "description": "Use the Micro USB connector marked CH340 for serial communication and firmware downloading through the onboard USB-to-UART bridge."
            },
            {
              "key": "download-button",
              "name": "Download button",
              "description": "Used with Reset to enter the bootloader for programming. Follow the SDK getting-started instructions for the button sequence."
            },
            {
              "key": "reset-button",
              "name": "Reset button",
              "description": "Restarts the board. The firmware burner includes the programming workflow and a live serial console."
            },
            {
              "key": "leds",
              "name": "Status LEDs",
              "description": "Onboard indicator LEDs provide power and application status. Programmable LED behavior depends on your firmware."
            },
            {
              "key": "headers",
              "name": "Expansion headers",
              "description": "Two rows of headers expose power and peripheral signals at a 2.54 mm pitch. Consult the pinout before connecting external hardware."
            },
            {
              "key": "microsd",
              "name": "microSD slot",
              "description": "The metal card socket accepts removable storage for supported firmware applications, such as recording images or video."
            },
            {
              "key": "microphone",
              "name": "Microphone",
              "description": "The onboard microphone provides audio input for supported capture and streaming examples."
            },
            {
              "key": "module",
              "name": "AmebaPRO2 / RTL8735B module",
              "description": "The module on the reverse houses the RTL8735B-based processing and wireless circuitry. Shield and component appearance vary by hardware revision."
            },
            {
              "key": "antenna",
              "name": "External Wi-Fi antenna",
              "description": "The external antenna connects by a thin coaxial lead. This model includes its placement for a typical camera development setup."
