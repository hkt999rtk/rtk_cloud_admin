{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.realtekconnect.com/chipset-sdk-provider/chipset-resource-package-v1.schema.json",
  "title": "Chipset Resource Package v1 authoring profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "manifest_version", "provider", "chipsets"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "manifest_version": { "const": "1" },
    "provider": {
      "type": "object",
      "required": ["name", "updated_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "chipsets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/chipset" }
    }
  },
  "$defs": {
    "chipset": {
      "type": "object",
      "required": ["chipset_key", "vendor", "name", "resources", "sdk_releases"],
      "properties": {
        "chipset_key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 200 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "family": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "resources": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/resource" }
        },
        "sdk_releases": {
          "type": "array",
          "maxItems": 64,
          "contains": {
            "type": "object",
            "required": ["recommended"],
            "properties": { "recommended": { "const": true } }
          },
          "minContains": 0,
          "maxContains": 1,
          "items": { "$ref": "#/$defs/sdk_release" }
        }
      }
    },
    "sdk_release": {
      "type": "object",
      "required": ["name", "version", "recommended", "supported_models", "endpoints"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 4000 },
        "recommended": { "type": "boolean" },
        "supported_models": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "endpoints": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["type", "title", "url", "source", "languages", "verified_at"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source": { "type": "string", "enum": ["official", "community"] },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
        },
        "verified_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "maxLength": 1000 },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
