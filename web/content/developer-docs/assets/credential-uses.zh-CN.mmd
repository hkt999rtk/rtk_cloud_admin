flowchart TB
    Login["客户经理登入"] --> AccountToken["帐户访问令牌"]
    AccountToken --> AccountAPI["帐户/组织API"]
    DeviceKey["装置证书和本地私钥"] -->|"已验证的mTLS"| Issue["执行时令牌发行"]
    AppKey["应用程式证书和应用程式本地私钥"] -->|"经过验证的mTLS加上目标授权"| Issue
    Issue --> JWT["范围内的执行时JWT和MQTT元资料"]
    JWT --> Broker["MQTT连线"]
    Issue -->|"请求了aws_iot_data"| Bundle["短暂的SigV4捆绑包"]
    Bundle --> Shadow["签名的HTTP影子API"]
