flowchart TB
    subgraph Factory["工廠層"]
        Identity["裝置身分與標準服務授權"]
    end
    subgraph Account["帳戶層"]
        Claim["認領／使用者與組織綁定"] --> Activation["非同步配置作業"]
        Release["解除配置"] -->|"解除"| Claim
    end
    subgraph Runtime["執行階段層"]
        Enabled["雲端啟用狀態"]
        Owner["目前 owner 傳輸連線"]
        Shadow["持久儲存的影子狀態"]
    end
    Identity --> Claim
    Activation --> Enabled
    Enabled -->|"允許獲授權的執行階段存取"| Owner
    Enabled -->|"允許獲授權的狀態存取"| Shadow
    Release -.->|"保留"| Identity
    Owner -.->|"與儲存狀態彼此獨立"| Shadow
    Status["裝置群／就緒狀態：檢查來源與觀測時間"]
    Activation --> Status
    Owner --> Status
