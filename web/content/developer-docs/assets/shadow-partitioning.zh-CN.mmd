flowchart TB
    Device["一个运行时设备身份"] --> Config["命名影子：configuration"]
    Device --> Diagnostics["命名影子：diagnostics"]
    Device --> Default["未命名影子"]
    Config --> Desired["desired 预期配置"]
    Config --> Reported["reported 已应用的配置"]
    Diagnostics --> Status["大小有上限的应用程序诊断状态"]
    Rules["各影子独立管理版本、大小限制与生命周期"] -.-> Config
    Rules -.-> Diagnostics
    Rules -.-> Default
    Boundary["没有跨影子事务；名称本身不提供隔离保证。"] -.-> Rules
