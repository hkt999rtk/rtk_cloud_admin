flowchart TB
    Login["Account Manager login"] --> AccountToken["Account access token"]
    AccountToken --> AccountAPI["Account / organization APIs"]
    DeviceKey["Device certificate and local private key"] -->|"verified mTLS"| Issue["Runtime token issuance"]
    AppKey["App certificate and app-local private key"] -->|"verified mTLS plus target authorization"| Issue
    Issue --> JWT["Scoped runtime JWT and MQTT metadata"]
    JWT --> Broker["MQTT CONNECT"]
    Issue -->|"aws_iot_data requested"| Bundle["Short-lived SigV4 bundle"]
    Bundle --> Shadow["Signed HTTP Shadow API"]
