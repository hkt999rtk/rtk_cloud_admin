flowchart TB
    subgraph Factory["工厂层"]
        Identity["设备身份与标准服务授权"]
    end
    subgraph Account["账户层"]
        Claim["认领／用户与组织绑定"] --> Activation["异步配置作业"]
        Release["解除配置"] -->|"解除"| Claim
    end
    subgraph Runtime["运行时层"]
        Enabled["云端启用状态"]
        Owner["当前 owner 传输连接"]
        Shadow["持久存储的影子状态"]
    end
    Identity --> Claim
    Activation --> Enabled
    Enabled -->|"允许获授权的运行时访问"| Owner
    Enabled -->|"允许获授权的状态访问"| Shadow
    Release -.->|"保留"| Identity
    Owner -.->|"与存储状态彼此独立"| Shadow
    Status["设备群／就绪状态：检查来源与观测时间"]
    Activation --> Status
    Owner --> Status
